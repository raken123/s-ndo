<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Ljudkategorin. Den är den enda Sändo Elev kan komma in i: en studieapp
         finns inte på Apples lista, en ljudapp gör det. Ansök om just den här
         nyckeln och beskriv appen som en uppspelare av inspelade repetitioner. -->
    <key>com.apple.developer.carplay-audio</key>
    <true/>
    <!-- Delad mapp med telefonappen: eleven väljer kapitel där, bilen läser
         filen därifrån. Måste stämma med Fillager.appgrupp. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.se.sando.elev</string>
    </array>
</dict>
</plist>
