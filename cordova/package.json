{
  "name": "sando-fandom",
  "version": "1.0.0",
  "displayName": "Sändo Fandom",
  "description": "Cordova-app för att bygga sin fandom: fotoredigerare, affischbyggare, korta videor, publik vägg och eventplanerare.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "icons": "python3 tools/make_icons.py",
    "android": "cordova run android",
    "ios": "cordova run ios",
    "build:android": "cordova build android --release",
    "build:ios": "cordova build ios --release",
    "serve": "cordova serve"
  },
  "cordova": {
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": {
      "cordova-plugin-splashscreen": {},
      "cordova-plugin-statusbar": {},
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-media-capture": {},
      "cordova-plugin-file": {}
    }
  },
  "devDependencies": {
    "cordova": "^12.0.0",
    "cordova-android": "^14.0.1",
    "cordova-ios": "^7.1.1",
    "cordova-plugin-camera": "^7.0.0",
    "cordova-plugin-file": "^8.1.0",
    "cordova-plugin-media-capture": "^5.0.0",
    "cordova-plugin-splashscreen": "^6.0.2",
    "cordova-plugin-statusbar": "^4.0.0"
  }
}