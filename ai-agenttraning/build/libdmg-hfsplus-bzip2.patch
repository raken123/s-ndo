diff --git a/dmg/CMakeLists.txt b/dmg/CMakeLists.txt
index c57e5e4..9a13c47 100644
--- a/dmg/CMakeLists.txt
+++ b/dmg/CMakeLists.txt
@@ -6,7 +6,7 @@ ENDIF(NOT ZLIB_FOUND)
 
 add_library(dmg abstractfile.c base64.c checksum.c crc32.c dmglib.c io.c resources.c udif.c)
 
-target_link_libraries(dmg z)
+target_link_libraries(dmg z bz2)
 
 add_executable(dmg-bin dmg.c)
 target_link_libraries(dmg-bin dmg)
diff --git a/dmg/io.c b/dmg/io.c
index b600438..a3ba524 100644
--- a/dmg/io.c
+++ b/dmg/io.c
@@ -2,6 +2,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include <zlib.h>
+#include <bzlib.h>
 
 #include <dmg.h>
 #include <inttypes.h>
@@ -10,6 +11,9 @@
 #define ENTIRE_DEVICE_DESCRIPTOR 0xFFFFFFFE
 #define SECTORS_AT_A_TIME 0x200 // 512
 #define SECTOR_SIZE 512
+// UDBZ (bzip2) images use 1 MiB chunks, like hdiutil
+#define BZ_SECTORS_AT_A_TIME 0x800
+#define BZ_BUFFERS_NEEDED 0x808
 
 BLKXTable *insertBLKX(AbstractFile *out, AbstractFile *in,
                       ChecksumFunc uncompressedChk, void *uncompressedChkToken,
@@ -27,6 +31,8 @@ BLKXTable *insertBLKX(AbstractFile *out, AbstractFile *in,
   int ret;
 
   uint32_t numSectors = in->getLength(in) / SECTOR_SIZE;
+  int useBz = getenv("DMG_BZIP2") != NULL;
+  uint32_t chunkSectors = useBz ? BZ_SECTORS_AT_A_TIME : SECTORS_AT_A_TIME;
 
   z_stream strm;
 
@@ -38,7 +44,7 @@ BLKXTable *insertBLKX(AbstractFile *out, AbstractFile *in,
   blkx->firstSectorNumber = 0;
   blkx->sectorCount = numSectors;
   blkx->dataStart = 0;
-  blkx->decompressBufferRequested = BUFFERS_NEEDED;
+  blkx->decompressBufferRequested = useBz ? BZ_BUFFERS_NEEDED : BUFFERS_NEEDED;
   blkx->blocksDescriptor = ENTIRE_DEVICE_DESCRIPTOR;
   blkx->reserved1 = 0;
   blkx->reserved2 = 0;
@@ -54,7 +60,8 @@ BLKXTable *insertBLKX(AbstractFile *out, AbstractFile *in,
   bufferSize = SECTOR_SIZE * blkx->decompressBufferRequested;
 
   ASSERT(inBuffer = (unsigned char *)malloc(bufferSize), "malloc");
-  ASSERT(outBuffer = (unsigned char *)malloc(bufferSize), "malloc");
+  // bzip2 can grow incompressible input by ~1% + 600 bytes
+  ASSERT(outBuffer = (unsigned char *)malloc(bufferSize * 2), "malloc");
 
   while (numSectors > 0) {
     if (curRun >= roomForRuns) {
@@ -63,11 +70,11 @@ BLKXTable *insertBLKX(AbstractFile *out, AbstractFile *in,
                                             (roomForRuns * sizeof(BLKXRun)));
     }
 
-    blkx->runs[curRun].type = BLOCK_ZLIB;
+    blkx->runs[curRun].type = useBz ? BLOCK_BZIP2 : BLOCK_ZLIB;
     blkx->runs[curRun].reserved = 0;
     blkx->runs[curRun].sectorStart = curSector;
     blkx->runs[curRun].sectorCount =
-        (numSectors > SECTORS_AT_A_TIME) ? SECTORS_AT_A_TIME : numSectors;
+        (numSectors > chunkSectors) ? chunkSectors : numSectors;
 
     memset(&strm, 0, sizeof(strm));
     strm.zalloc = Z_NULL;
@@ -77,7 +84,8 @@ BLKXTable *insertBLKX(AbstractFile *out, AbstractFile *in,
     // printf("run %d: sectors=%" PRId64 ", left=%d\n", curRun,
     // blkx->runs[curRun].sectorCount, numSectors);
 
-    ASSERT(deflateInit(&strm, Z_DEFAULT_COMPRESSION) == Z_OK, "deflateInit");
+    if (!useBz)
+      ASSERT(deflateInit(&strm, Z_DEFAULT_COMPRESSION) == Z_OK, "deflateInit");
 
     ASSERT((strm.avail_in = in->read(
                 in, inBuffer, blkx->runs[curRun].sectorCount * SECTOR_SIZE)) ==
@@ -92,15 +100,23 @@ BLKXTable *insertBLKX(AbstractFile *out, AbstractFile *in,
     blkx->runs[curRun].compOffset = out->tell(out) - blkx->dataStart;
     blkx->runs[curRun].compLength = 0;
 
-    strm.avail_out = bufferSize;
-    strm.next_out = outBuffer;
-
-    ASSERT((ret = deflate(&strm, Z_FINISH)) != Z_STREAM_ERROR,
-           "deflate/Z_STREAM_ERROR");
-    if (ret != Z_STREAM_END) {
-      ASSERT(0, "deflate");
+    if (useBz) {
+      unsigned int destLen = bufferSize * 2;
+      ret = BZ2_bzBuffToBuffCompress((char *)outBuffer, &destLen,
+                                     (char *)inBuffer, strm.avail_in, 9, 0, 0);
+      ASSERT(ret == BZ_OK, "BZ2_bzBuffToBuffCompress");
+      have = destLen;
+    } else {
+      strm.avail_out = bufferSize;
+      strm.next_out = outBuffer;
+
+      ASSERT((ret = deflate(&strm, Z_FINISH)) != Z_STREAM_ERROR,
+             "deflate/Z_STREAM_ERROR");
+      if (ret != Z_STREAM_END) {
+        ASSERT(0, "deflate");
+      }
+      have = bufferSize - strm.avail_out;
     }
-    have = bufferSize - strm.avail_out;
 
     if ((have / SECTOR_SIZE) > blkx->runs[curRun].sectorCount) {
       blkx->runs[curRun].type = BLOCK_RAW;
@@ -124,7 +140,8 @@ BLKXTable *insertBLKX(AbstractFile *out, AbstractFile *in,
       blkx->runs[curRun].compLength += have;
     }
 
-    deflateEnd(&strm);
+    if (!useBz)
+      deflateEnd(&strm);
 
     curSector += blkx->runs[curRun].sectorCount;
     numSectors -= blkx->runs[curRun].sectorCount;
diff --git a/includes/dmg.h b/includes/dmg.h
index d40a223..3f998e4 100644
--- a/includes/dmg.h
+++ b/includes/dmg.h
@@ -12,6 +12,7 @@
 #define CHECKSUM_NONE 0x0000
 
 #define BLOCK_ZLIB 0x80000005
+#define BLOCK_BZIP2 0x80000006
 #define BLOCK_RAW 0x00000001
 #define BLOCK_TERMINATOR 0xFFFFFFFF
 
