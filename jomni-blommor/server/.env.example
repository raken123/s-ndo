# Kopiera till .env och fyll i. .env checkas aldrig in.
PORT=8080
PUBLIC_URL=https://jomniblommor.se

# Byt adminlösenord (annars gäller det inbyggda standardlösenordet)
# ADMIN_PASSWORD=

# Stripe – ger kort, Apple Pay och Google Pay
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
APPLE_MERCHANT_ID=merchant.se.jomni.blommor

# Push till iPhone-appen (Apple Developer → Keys → Apple Push Notifications)
APNS_KEY_FILE=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=se.jomni.blommor

# Endast för test utan Stripe: tillåt demobetalningar
# DEMO_MODE=1
