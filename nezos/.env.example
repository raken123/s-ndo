# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Optional
PORT=3000
NODE_ENV=development          # "production" makes session cookies Secure (HTTPS only)
BILLING_MODE=demo             # demo = plan changes are free/instant. Anything else disables upgrades until payments are wired up.
TRUST_PROXY=0                 # set to 1 behind a reverse proxy (correct client IPs for rate limiting)
AUTH_RATE_LIMIT=10            # sign-up / login attempts per IP per minute
# NEZOS_DATA_DIR=./data       # where db.json and generated assets live
