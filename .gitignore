# ...except the two ad pipelines, which are the source for clips we ship or
# publish. Both are self-contained — no walkthrough scene graph.
#   shared:      gfx (drawing toolkit), admusic (soundtrack)
#   in-app ads:  vidads (fictional-brand spots) + render_vidads
#   gmfy promos: v340 (portrait teasers) + world (3D preview) + render_v340
!ad/gfx.py
!ad/admusic.py
!ad/vidads.py
!ad/render_vidads.py
!ad/v340.py
!ad/world.py
!ad/render_v340.py

