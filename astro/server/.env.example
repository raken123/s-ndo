# Kopiera till .env och fyll i. Alla värden kan också sättas som miljövariabler.

# Porten servern lyssnar på (lägg en https-proxy, t.ex. nginx/Caddy/IIS, framför)
PORT=8787
# Den publika adressen som besökarna får i mejlet (måste nås från internet)
PUBLIC_URL=https://astro.tekniskamuseet.se

# Hemlig nyckel – samma värde skrivs in i spelets administratörspanel (API-nyckel)
API_KEY=byt-till-en-lang-slumpmassig-nyckel

# Avsändare
MAIL_FROM=astro@tekniskamuseet.se
MAIL_FROM_NAME=Astro – Tekniska museet
# MAIL_REPLY_TO=info@tekniskamuseet.se

# SMTP-konto för astro@tekniskamuseet.se (t.ex. Microsoft 365: smtp.office365.com, port 587)
# Utan SMTP_HOST skickas inga mejl – de sparas som .eml-filer i data/outbox (för test).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=astro@tekniskamuseet.se
SMTP_PASS=
# SMTP_SECURE=true          # för port 465
# SMTP_REQUIRE_TLS=false    # tillåt okrypterad SMTP (endast intern relay)

# Hur länge filmerna sparas (dagar) och största tillåtna fil
RETENTION_DAYS=30
MAX_UPLOAD_MB=600
DATA_DIR=data

# ffmpeg gör en MP4-kopia som spelas på alla telefoner (lämna tomt för att stänga av)
FFMPEG=ffmpeg
